   "source": [
    "import pyautogui as pyg\n",
    "pyg.sleep(2) # sleep 2 s\n",
    "pyg.press('space') # 啟動\n",
    "\n",
    "# 無窮迴圈\n",
    "while True:\n",
    "    im=pyg.screenshot() #擷取畫面\n",
    "    obs=False # 假設沒有仙人掌\n",
    "    for i in range(15):\n",
    "        c_cactus = im.getpixel((229+i, 373)) #仙人掌\n",
    "        c_bird = im.getpixel((229 + i, 330))   #翼龍\n",
    "        if c_cactus == (83, 83, 83) or c_cactus == (172, 172, 172):\n",
    "            pyg.press('space')\n",
    "            obs = True\n",
    "            break\n",
    "        if c_bird == (83, 83, 83) or c_bird == (172, 172, 172):\n",
    "            pyg.press('down')\n",
    "            obs = True\n",
    "            break\n",
    "    \n",
    "    if obs == False: #沒有障礙物\n",
    "        pass  # 繼續監視\n",
    "    else: #有障礙物\n",
    "        pass\n",
    "\n"
